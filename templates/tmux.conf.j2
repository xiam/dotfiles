# Tmux {{ theme.name }} workstation configuration
set -g prefix C-b
set -g history-limit 99999
set -g mouse off
set -s set-clipboard off
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on
setw -g automatic-rename off
set -g allow-rename off
set -sg escape-time 0
set -g focus-events on
set -g display-time 2000
set -g set-titles on
set -g set-titles-string "#T :: #W"
set -g mode-keys vi
bind -T copy-mode-vi v send -X begin-selection
bind -T copy-mode-vi y send -X copy-selection-and-cancel

bind r source-file ~/.tmux.conf \; display "Config reloaded!"
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
bind '"' split-window -v -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R
bind -n M-h select-pane -L
bind -n M-j select-pane -D
bind -n M-k select-pane -U
bind -n M-l select-pane -R
bind -n M-Left select-pane -L
bind -n M-Right select-pane -R
bind -n M-Up select-pane -U
bind -n M-Down select-pane -D
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5
bind -n M-1 select-window -t 1
bind -n M-2 select-window -t 2
bind -n M-3 select-window -t 3
bind -n M-4 select-window -t 4
bind -n M-5 select-window -t 5
bind -n M-6 select-window -t 6
bind -n M-7 select-window -t 7
bind -n M-8 select-window -t 8
bind -n M-9 select-window -t 9
bind c new-window -c "#{pane_current_path}"
bind x kill-pane
bind X kill-window
bind S setw synchronize-panes \; display "Sync #{?synchronize-panes,ON,OFF}"
bind m set-option -g mouse on \; display "Mouse: ON"
bind M set-option -g mouse off \; display "Mouse: OFF"

# F12 toggles nested tmux passthrough.
bind -T root F12 set prefix None \; set key-table off \; set status-style "bg={{ theme.error }},fg={{ theme.bg }}" \; refresh-client -S
bind -T off F12 set -u prefix \; set -u key-table \; set -u status-style \; refresh-client -S

set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",*256col*:Tc"
set -g pane-border-style "fg={{ theme.surface }}"
set -g pane-active-border-style "fg={{ theme.accent2 }}"
set -g window-style "fg={{ theme.pane_inactive_fg }},bg={{ theme.bg }}"
set -g window-active-style "fg={{ theme.fg }},bg={{ theme.bg }}"
set -g status-position bottom
set -g status-interval 5
set -g status-style "bg={{ theme.bg }},fg={{ theme.fg }}"
set -g status-left-length 40
set -g status-right-length 80
set -g status-left "#[fg={{ theme.bg }},bg={{ theme.accent2 }},bold] #S #[default] "
set -g status-right "#[fg={{ theme.muted }}]%H:%M %Y-%m-%d"
setw -g window-status-format "#[fg={{ theme.muted }}]#I:#W"
setw -g window-status-current-format "#[fg={{ theme.bg }},bg={{ theme.accent2 }},bold] #I:#W #[default]"
setw -g window-status-separator "  "
setw -g monitor-bell on
set -g visual-bell off
set -g message-style "bg={{ theme.surface }},fg={{ theme.fg }}"
set -g mode-style "bg={{ theme.accent2 }},fg={{ theme.bg }},bold"
set -g clock-mode-colour "{{ theme.accent2 }}"
setw -g monitor-activity on
set -g visual-activity off

# Optional per-machine settings load last.
if-shell '[ -f ~/.tmux.conf.local ]' 'source-file ~/.tmux.conf.local'
